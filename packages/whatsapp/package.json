{
  "name": "@fi/whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Submódulo WhatsApp: conexión Baileys, recepción y envío de mensajes",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fi/core": "workspace:*",
    "@hapi/boom": "catalog:",
    "baileys": "catalog:",
    "pino": "catalog:",
    "qrcode-terminal": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
