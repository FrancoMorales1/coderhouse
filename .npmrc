# Solo pnpm: bloquea npm install / yarn install en este repo.
engine-strict=true

# Los tipos y utilidades de un package no se filtran a los demás.
auto-install-peers=true
strict-peer-dependencies=false

# Los deploys y CI fallan si el lockfile quedó desactualizado.
prefer-frozen-lockfile=true

# Salida más legible en CI.
loglevel=warn
